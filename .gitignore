# Private or large research inputs
/data/**
!/data/.gitkeep
/outputs/**
!/outputs/.gitkeep
/results/**
!/results/.gitkeep
/figures/**
!/figures/.gitkeep
*.tif
*.tiff
*.nc
*.h5
*.hdf5
*.npz
*.gpkg
*.shp
*.shx
*.dbf
*.prj
*.zip
*.xlsx
*.xls
*.csv
*.png
*.jpg
*.jpeg
*.pdf
*.docx
*.doc
# Never commit credentials or local runtime artifacts
.env
*.json.key
*credentials*
*token*
.ipynb_checkpoints/
__pycache__/
*.py[cod]
.DS_Store
.vscode/
